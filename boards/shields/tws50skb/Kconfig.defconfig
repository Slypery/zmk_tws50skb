if SHIELD_TWS50SKB_LEFT || SHIELD_TWS50SKB_RIGHT || SHIELD_TWS50SKB_DONGLE

config ZMK_SPLIT
    default y

endif # SHIELD_TWS50SKB_LEFT || SHIELD_TWS50SKB_RIGHT || SHIELD_TWS50SKB_DONGLE

if SHIELD_TWS50SKB_LEFT || SHIELD_TWS50SKB_DONGLE

config ZMK_KEYBOARD_NAME
    default "tws50skb"

endif # SHIELD_TWS50SKB_LEFT || SHIELD_TWS50SKB_DONGLE

if SHIELD_TWS50SKB_DONGLE

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif # SHIELD_TWS50SKB_DONGLE